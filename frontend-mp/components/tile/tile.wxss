.tile {
  width: 68rpx;
  height: 92rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-tile-border);
  background: linear-gradient(165deg, #FFFDE7 0%, #F5F0E8 50%, #EDE7D9 100%);
  box-shadow: 2rpx 3rpx 6rpx rgba(62, 39, 35, 0.18), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.6);
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  margin: 2rpx;
}

.tile-small {
  width: 48rpx;
  height: 66rpx;
}

.tile-small .tile-text {
  font-size: 26rpx;
}

.tile-small .tile-sub {
  font-size: 14rpx;
}

.tile-selected {
  transform: translateY(-10rpx);
  box-shadow: 0 6rpx 14rpx rgba(27, 94, 32, 0.4);
  border-color: var(--color-primary);
  border-width: 3rpx;
}

.tile-text {
  font-family: 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.tile-sub {
  font-family: 'STKaiti', 'KaiTi', serif;
  font-size: 18rpx;
  line-height: 1;
  margin-top: 2rpx;
  opacity: 0.7;
}

.tile-wan .tile-text,
.tile-wan .tile-sub {
  color: var(--color-wan);
}

.tile-tiao .tile-text,
.tile-tiao .tile-sub {
  color: var(--color-tiao);
}

.tile-tong .tile-text,
.tile-tong .tile-sub {
  color: var(--color-tong);
}

.tile-feng .tile-text {
  color: var(--color-feng);
}

.tile-jian-zhong .tile-text {
  color: var(--color-jian-zhong);
  font-size: 38rpx;
}

.tile-jian-fa .tile-text {
  color: var(--color-jian-fa);
  font-size: 38rpx;
}

.tile-jian-bai .tile-text {
  color: var(--color-jian-bai);
  font-size: 38rpx;
}

.tile-tiny {
  width: 28rpx;
  height: 38rpx;
  border-radius: 4rpx;
  border-width: 1rpx;
  margin: 1rpx;
  box-shadow: 1rpx 1rpx 3rpx rgba(62, 39, 35, 0.15);
}

.tile-tiny .tile-text {
  font-size: 18rpx;
}

.tile-tiny .tile-sub {
  display: none;
}

.tile-tiny .tile-back-pattern {
  width: 18rpx;
  height: 26rpx;
  border-width: 1rpx;
  border-radius: 2rpx;
}

.tile-back {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #388E3C 100%);
  border-color: #0D3B11;
}

.tile-back-pattern {
  width: 36rpx;
  height: 50rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 4rpx,
    rgba(255, 255, 255, 0.08) 4rpx,
    rgba(255, 255, 255, 0.08) 8rpx
  );
}

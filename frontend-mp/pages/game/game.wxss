/* === 横屏麻将牌桌 === */

.game-page {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 40%, #256D28 70%, #1A5C1F 100%);
  overflow: hidden;
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
}

/* --- 状态栏 --- */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 20rpx;
  background: rgba(0, 0, 0, 0.35);
  height: 32rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 18rpx;
  color: #FFE082;
  font-weight: 600;
  flex: 1;
}

.wall-info {
  font-size: 16rpx;
  color: rgba(255, 253, 231, 0.7);
  background: rgba(0, 0, 0, 0.25);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* --- 主牌桌区 (flex row) --- */
.main-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  min-height: 0;
  padding: 4rpx;
  gap: 4rpx;
}

/* --- 左右AI列 --- */
.side-col {
  width: 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 0;
  justify-content: center;
}

.side-name {
  font-size: 14rpx;
  color: rgba(255, 253, 231, 0.8);
  font-family: var(--font-title);
  writing-mode: vertical-rl;
  letter-spacing: 2rpx;
}

.side-count {
  font-size: 14rpx;
  color: rgba(255, 253, 231, 0.6);
}

.side-melds {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rpx;
  margin-top: 4rpx;
}

/* --- 中央牌桌 --- */
.table-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}

/* 顶部AI-南 */
.top-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 2rpx 0;
  flex-shrink: 0;
}

.top-name {
  font-size: 14rpx;
  color: rgba(255, 253, 231, 0.8);
  font-family: var(--font-title);
  flex-shrink: 0;
}

.top-hand {
  display: flex;
  gap: 1rpx;
}

.top-melds {
  display: flex;
  gap: 1rpx;
  margin-left: 8rpx;
}

.meld-gap {
  width: 4rpx;
}

/* --- 弃牌区 (田字形) --- */
.discard-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 10rpx;
  padding: 4rpx 8rpx;
  margin: 2rpx 0;
  min-height: 0;
}

.dz-top, .dz-bottom {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rpx;
  padding: 2rpx 0;
  flex-shrink: 0;
  min-height: 0;
}

.dz-mid {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 0;
  gap: 4rpx;
}

.dz-west, .dz-east {
  width: 160rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 1rpx;
  align-content: center;
  flex-shrink: 0;
}

.dz-west {
  justify-content: flex-end;
}

.dz-east {
  justify-content: flex-start;
}

.dz-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.last-discard-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.hint-text {
  font-size: 16rpx;
  color: #FFE082;
  font-weight: 600;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 玩家副露(牌桌内) */
.my-melds {
  display: flex;
  justify-content: center;
  gap: 1rpx;
  padding: 2rpx 0;
  flex-shrink: 0;
}

/* --- 底部: 操作 + 手牌 --- */
.player-bar {
  flex-shrink: 0;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.15) 100%);
  padding: 4rpx 12rpx 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-group {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.act-btn {
  padding: 0 16rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  font-family: var(--font-title);
  border: none;
  min-width: 52rpx;
  text-align: center;
}

.act-btn:active { opacity: 0.8; }

.act-pass { background: rgba(255, 255, 255, 0.2); color: #fff; }
.act-chi { background: linear-gradient(135deg, #1565C0, #42A5F5); color: #fff; }
.act-pong { background: linear-gradient(135deg, #E65100, #FF9800); color: #fff; }
.act-kong { background: linear-gradient(135deg, #4A148C, #AB47BC); color: #fff; }
.act-win { background: linear-gradient(135deg, #B71C1C, #F44336); color: #fff; box-shadow: 0 0 12rpx rgba(244, 67, 54, 0.5); }

.hand-tiles {
  flex: 1;
  display: flex;
  gap: 2rpx;
  justify-content: center;
  min-width: 0;
}

.discard-btn {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-light));
  color: #fff;
  border: none;
  border-radius: 8rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  font-family: var(--font-title);
  letter-spacing: 4rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-md);
}

.discard-btn:active { opacity: 0.8; }

/* --- 出牌飞行动画 --- */
.flying-tile {
  position: fixed;
  bottom: 12vh;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  pointer-events: none;
  animation: flyToTable 0.8s ease-out forwards;
}

@keyframes flyToTable {
  0% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  100% {
    opacity: 0.4;
    transform: translateX(-50%) translateY(-30vh) scale(0.6);
  }
}

/* --- 结算弹窗 --- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.result-modal {
  width: 50%;
  max-width: 400rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: var(--shadow-lg);
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.result-title {
  font-family: 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-primary-dark);
}

.result-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.result-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 8rpx;
}

.r-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  padding: 0;
}

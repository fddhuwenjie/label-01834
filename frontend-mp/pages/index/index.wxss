.index-page {
  padding-bottom: 32rpx;
}

.hero-section {
  position: relative;
  height: 320rpx;
  overflow: hidden;
  margin-bottom: -40rpx;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #1B5E20 0%, #2E7D32 60%, transparent 100%);
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  z-index: 1;
}

.hero-title {
  font-family: 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
  font-size: 64rpx;
  font-weight: 900;
  color: #FFFDE7;
  letter-spacing: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 253, 231, 0.8);
  margin-top: 8rpx;
  letter-spacing: 6rpx;
}

.user-card {
  margin: 0 32rpx 24rpx;
  position: relative;
  z-index: 2;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.avatar-text {
  font-family: var(--font-title);
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-family: var(--font-title);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.user-stats {
  font-size: 24rpx;
}

.start-section {
  padding: 16rpx 32rpx 32rpx;
}

.start-btn {
  width: 100%;
  height: 108rpx;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  border-radius: var(--radius-lg);
  padding-top: 0;
  padding-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-card {
  margin: 0 32rpx 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  background: rgba(27, 94, 32, 0.04);
  border-radius: var(--radius-sm);
}

.stat-value {
  font-family: var(--font-title);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.win-color { color: var(--color-success); }
.lose-color { color: var(--color-error); }

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  background: rgba(27, 94, 32, 0.03);
  border-radius: var(--radius-sm);
}

.result-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.result-win { background: var(--color-success); }
.result-lose { background: var(--color-error); }
.result-draw { background: var(--color-text-light); }

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.recent-rounds { font-size: 28rpx; font-weight: 500; }
.recent-time { font-size: 22rpx; }
.recent-score { font-size: 28rpx; font-weight: 600; }

.deco-tiles {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0 16rpx;
  opacity: 0.6;
}

.card {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

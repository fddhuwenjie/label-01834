.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1B5E20 0%, #2E7D32 40%, #F5F0E8 60%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE082 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 24rpx;
}

.logo-text {
  font-family: 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
  font-size: 80rpx;
  font-weight: 900;
  color: #1B5E20;
}

.app-title {
  font-family: var(--font-title);
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFDE7;
  letter-spacing: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.app-subtitle {
  font-size: 24rpx;
  color: rgba(255, 253, 231, 0.8);
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.login-card {
  width: 85%;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-lg);
}

.tab-bar {
  display: flex;
  margin-bottom: 40rpx;
  background: rgba(27, 94, 32, 0.06);
  border-radius: var(--radius-md);
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
  transition: all 0.25s ease;
}

.tab-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.form-group {
  margin-bottom: 28rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F5F0E8;
  border-radius: var(--radius-md);
  padding: 4rpx 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.input-wrapper:focus-within {
  border-color: var(--color-primary);
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.icon-user {
  border-radius: 50%;
  border: 3rpx solid #8D6E63;
  width: 22rpx;
  height: 22rpx;
  position: relative;
  margin-left: 4rpx;
}

.icon-user::after {
  content: '';
  display: block;
  width: 32rpx;
  height: 16rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #8D6E63;
  position: absolute;
  bottom: -18rpx;
  left: -8rpx;
}

.icon-lock {
  width: 26rpx;
  height: 20rpx;
  border: 3rpx solid #8D6E63;
  border-radius: 4rpx;
  position: relative;
  margin-top: 14rpx;
  margin-left: 4rpx;
}

.icon-lock::before {
  content: '';
  display: block;
  width: 16rpx;
  height: 14rpx;
  border: 3rpx solid #8D6E63;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  position: absolute;
  top: -17rpx;
  left: 2rpx;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.login-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  padding-top: 0;
  padding-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-footer {
  margin-top: 60rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-light);
  letter-spacing: 2rpx;
}

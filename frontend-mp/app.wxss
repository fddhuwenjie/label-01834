/* 国风麻将 — 全局样式 Design Tokens */
page {
  --color-primary: #1B5E20;
  --color-primary-light: #4CAF50;
  --color-primary-dark: #0D3B11;
  --color-accent: #FF6F00;
  --color-accent-light: #FFA040;
  --color-bg: #F5F0E8;
  --color-bg-card: #FFFDF5;
  --color-bg-table: #2E7D32;
  --color-text: #3E2723;
  --color-text-secondary: #795548;
  --color-text-light: #A1887F;
  --color-border: #D7CCC8;
  --color-success: #2E7D32;
  --color-warning: #F57F17;
  --color-error: #C62828;
  --color-info: #1565C0;
  --color-tile-bg: linear-gradient(135deg, #FFFDE7 0%, #F5F0E8 100%);
  --color-tile-border: #BCAAA4;
  --color-wan: #3E2723;
  --color-tiao: #1B5E20;
  --color-tong: #1565C0;
  --color-feng: #3E2723;
  --color-jian-zhong: #C62828;
  --color-jian-fa: #1B5E20;
  --color-jian-bai: #9E9E9E;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(62, 39, 35, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(62, 39, 35, 0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(62, 39, 35, 0.16);
  --font-title: 'Noto Serif SC', 'STSong', serif;
  --font-body: 'Noto Sans SC', 'PingFang SC', sans-serif;

  font-family: var(--font-body);
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  font-family: var(--font-title);
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-primary[disabled] {
  opacity: 0.5;
  transform: none;
}

.btn-secondary {
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: rgba(27, 94, 32, 0.08);
  transform: scale(0.96);
}

.section-title {
  font-family: var(--font-title);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--color-accent);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--color-text-light);
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

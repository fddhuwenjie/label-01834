# 数据库配置
MYSQL_PORT=45213
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=mahjong_db

# 后端配置
BACKEND_PORT=38942
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=86400000

# Spring 数据源（后端使用）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:45213/mahjong_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123
